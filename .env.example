# Copy to .env and `source .env` before running dbt.
export DBT_GCP_PROJECT=your-gcp-project-id
export DBT_BQ_DATASET=dbt_medicare
# Optional: point ADC at a non-default credentials file
# export GOOGLE_APPLICATION_CREDENTIALS=$HOME/.config/gcloud/application_default_credentials.json
# Set to true when the GCP project has no billing (BigQuery sandbox). See macros/bq_sandbox.sql.
export DBT_BQ_SANDBOX=false
